#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>  ;
        rows = <4>;

        map = <
	 RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9)
	 RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9)
	 RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9)
					 RC(3,2) RC(3,3) RC(3,4)   RC(3,5)  RC(3,6) RC(3,7)
        >;
    };

    /* Approximate physical layout for the DYA Studio Keymap screen - key order
       matches default_transform's map 1:1. Coordinates are a generic split-ergo
       grid (100-unit pitch, 40-unit gap between halves), not measured from the
       real PCB, so positions in Studio's preview may not be pixel-accurate. */
    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Dragonball";
        transform = <&default_transform>;
        keys =
            <&key_physical_attrs 100 100    0   0 0 0 0>,
            <&key_physical_attrs 100 100  100   0 0 0 0>,
            <&key_physical_attrs 100 100  200   0 0 0 0>,
            <&key_physical_attrs 100 100  300   0 0 0 0>,
            <&key_physical_attrs 100 100  400   0 0 0 0>,
            <&key_physical_attrs 100 100  540   0 0 0 0>,
            <&key_physical_attrs 100 100  640   0 0 0 0>,
            <&key_physical_attrs 100 100  740   0 0 0 0>,
            <&key_physical_attrs 100 100  840   0 0 0 0>,
            <&key_physical_attrs 100 100  940   0 0 0 0>,

            <&key_physical_attrs 100 100    0 100 0 0 0>,
            <&key_physical_attrs 100 100  100 100 0 0 0>,
            <&key_physical_attrs 100 100  200 100 0 0 0>,
            <&key_physical_attrs 100 100  300 100 0 0 0>,
            <&key_physical_attrs 100 100  400 100 0 0 0>,
            <&key_physical_attrs 100 100  540 100 0 0 0>,
            <&key_physical_attrs 100 100  640 100 0 0 0>,
            <&key_physical_attrs 100 100  740 100 0 0 0>,
            <&key_physical_attrs 100 100  840 100 0 0 0>,
            <&key_physical_attrs 100 100  940 100 0 0 0>,

            <&key_physical_attrs 100 100    0 200 0 0 0>,
            <&key_physical_attrs 100 100  100 200 0 0 0>,
            <&key_physical_attrs 100 100  200 200 0 0 0>,
            <&key_physical_attrs 100 100  300 200 0 0 0>,
            <&key_physical_attrs 100 100  400 200 0 0 0>,
            <&key_physical_attrs 100 100  540 200 0 0 0>,
            <&key_physical_attrs 100 100  640 200 0 0 0>,
            <&key_physical_attrs 100 100  740 200 0 0 0>,
            <&key_physical_attrs 100 100  840 200 0 0 0>,
            <&key_physical_attrs 100 100  940 200 0 0 0>,

            <&key_physical_attrs 100 100  200 300 0 0 0>,
            <&key_physical_attrs 100 100  300 300 0 0 0>,
            <&key_physical_attrs 100 100  400 300 0 0 0>,
            <&key_physical_attrs 100 100  540 300 0 0 0>,
            <&key_physical_attrs 100 100  640 300 0 0 0>,
            <&key_physical_attrs 100 100  740 300 0 0 0>;
    };

    kscan0: kscan {
        diode-direction = "col2row";
    };
};


